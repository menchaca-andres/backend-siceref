generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum tipo_notificacion {
  MENSAJE_CHAT
}

enum estado_pago_qr {
  GENERANDO
  PENDIENTE
  PAGADO
  EXPIRADO
  CANCELADO
  FALLIDO
  ERROR
}

model roles {
  id_rol      Int        @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(50)
  nom_rol     String     @db.VarChar(50)
  descrip_rol String     @db.Text
  rolPerms    rol_perm[]
  usuarios    usuarios[]
}

model permisos {
  id_per   Int        @id @default(autoincrement())
  codigo   String     @unique @db.VarChar(80)
  nombre   String     @db.VarChar(50)
  rolPerms rol_perm[]
}

model rol_perm {
  id_rol  Int
  id_per  Int
  rol     roles    @relation(fields: [id_rol], references: [id_rol])
  permiso permisos @relation(fields: [id_per], references: [id_per])

  @@id([id_rol, id_per])
}

model usuarios {
  id_usu     Int      @id @default(autoincrement())
  img_usu    String?  @db.Text
  nom_usu    String   @db.VarChar(80)
  apell_usu  String   @db.VarChar(80)
  fecnac_usu DateTime @db.Date
  numcel_usu String   @db.VarChar(20)
  email_usu  String   @unique @db.VarChar(80)
  pass_usu   String   @db.Text

  id_rol                      Int
  rol                         roles            @relation(fields: [id_rol], references: [id_rol])
  id_ref                      Int?
  refugio                     refugios?        @relation(fields: [id_ref], references: [id_ref])
  pagos_qr_creados            pagos_qr[]        @relation("PagoQrCreador")
  pagos_qr_recibidos          pagos_qr[]        @relation("PagoQrReceptor")
  notificaciones              notificaciones[]
  mensajes_chat               mensajes_chat[]
  conversaciones              conversaciones[] @relation("ConversacionAdoptante")
  conversaciones_responsables conversaciones[] @relation("ConversacionResponsable")
  logs_usuario                logs_usuario[]
}

model logs_usuario {
  id_log Int @id @default(autoincrement())

  id_usu  Int?
  usuario usuarios? @relation(fields: [id_usu], references: [id_usu], onDelete: SetNull)

  accion     String   @db.VarChar(120)
  entidad    String?  @db.VarChar(80)
  id_entidad String?  @db.VarChar(80)
  detalle    Json?
  ip         String?  @db.VarChar(45)
  user_agent String?  @db.Text
  fecha_log  DateTime @default(now())

  @@index([id_usu])
  @@index([accion])
  @@index([entidad, id_entidad])
  @@index([fecha_log])
}

model refugios {
  id_ref        Int             @id @default(autoincrement())
  img_ref       String?         @db.Text
  nom_ref       String          @db.VarChar(80)
  direc_ref     String          @db.VarChar(150)
  telef_ref     String          @db.VarChar(20)
  email_ref     String          @unique @db.VarChar(80)
  estado_ref    Boolean         @default(true)
  usuarios      usuarios[]
  mascotas      mascotas[]
  publicaciones publicaciones[]
  pagos_qr      pagos_qr[]
}

model pagos_qr {
  id_pago Int @id @default(autoincrement())

  id_usu  Int?
  usuario usuarios? @relation("PagoQrCreador", fields: [id_usu], references: [id_usu])

  id_receptor Int?
  receptor    usuarios? @relation("PagoQrReceptor", fields: [id_receptor], references: [id_usu])

  id_ref  Int?
  refugio refugios? @relation(fields: [id_ref], references: [id_ref])

  provider_payment_id String?  @db.VarChar(80)
  provider      String         @default("local") @db.VarChar(30)
  validation_method String     @default("code_match") @db.VarChar(30)
  monto         Decimal        @db.Decimal(10, 2)
  monto_a_pagar Decimal?       @db.Decimal(10, 2)
  moneda        String         @default("BOB") @db.VarChar(3)
  glosa         String         @db.Text
  codigo        String         @db.VarChar(16)
  qr_payload    String?        @db.Text
  qr_image_base64 String?      @db.Text
  estado        estado_pago_qr @default(PENDIENTE)
  provider_status String?      @db.VarChar(30)
  provider_message String?     @db.Text
  estimated_seconds Float      @default(0)
  failover_count Int           @default(0)
  attempts      Json           @default("[]")
  notification  Json?
  fecha_expira  DateTime
  fecha_pagado  DateTime?
  fecha_creado  DateTime       @default(now())
  fecha_actualizado DateTime   @updatedAt

  @@index([provider_payment_id])
  @@index([codigo])
  @@index([estado])
}

model especies {
  id_esp  Int    @id @default(autoincrement())
  nom_esp String @db.VarChar(50)

  razas razas[]
}

model razas {
  id_raza  Int    @id @default(autoincrement())
  nom_raza String @db.VarChar(50)

  id_esp  Int
  especie especies @relation(fields: [id_esp], references: [id_esp])

  mascotas mascotas[]
}

model tamanios {
  id_tam     Int     @id @default(autoincrement())
  nom_tam    String  @unique @db.VarChar(50)
  estado_tam Boolean @default(true)

  mascotas mascotas[]
}

model mascotas {
  id_ani Int @id @default(autoincrement())

  nom_mascot      String   @db.VarChar(80)
  img_mascot      String?  @db.Text
  fechanac_mascot DateTime @db.Date
  esteril_mascot  Boolean
  sexo_mascot     String   @db.VarChar(10)
  caract_mascot   String   @db.Text
  fechaing_mascot DateTime @default(now()) @db.Date
  hist_mascot     String   @db.Text

  id_raza Int
  raza    razas @relation(fields: [id_raza], references: [id_raza])

  id_tam Int
  tamano tamanios @relation(fields: [id_tam], references: [id_tam])

  id_ref  Int
  refugio refugios @relation(fields: [id_ref], references: [id_ref])

  publicaciones publicaciones[]
}

model publicaciones {
  id_publi Int @id @default(autoincrement())

  fechapubli DateTime @default(now()) @db.Date
  estad_publ Boolean  @default(true)

  id_ani  Int
  mascota mascotas @relation(fields: [id_ani], references: [id_ani])

  id_ref  Int
  refugio refugios @relation(fields: [id_ref], references: [id_ref])

  notificaciones notificaciones[]
  conversaciones conversaciones[]
}

model notificaciones {
  id_noti Int @id @default(autoincrement())

  id_destinatario Int
  destinatario    usuarios @relation(fields: [id_destinatario], references: [id_usu])

  id_publi    Int?
  publicacion publicaciones? @relation(fields: [id_publi], references: [id_publi])

  tipo        tipo_notificacion
  titulo      String            @db.VarChar(120)
  mensaje     String            @db.Text
  leida       Boolean           @default(false)
  fecha_noti  DateTime          @default(now())
  fecha_leida DateTime?
}

model conversaciones {
  id_conv Int @id @default(autoincrement())

  id_usu  Int
  usuario usuarios @relation("ConversacionAdoptante", fields: [id_usu], references: [id_usu])

  id_responsable Int?
  responsable    usuarios? @relation("ConversacionResponsable", fields: [id_responsable], references: [id_usu])

  id_publi    Int
  publicacion publicaciones @relation(fields: [id_publi], references: [id_publi])

  fecha_creacion DateTime @default(now())

  mensajes mensajes_chat[]

  @@unique([id_usu, id_publi])
}

model mensajes_chat {
  id_msj Int @id @default(autoincrement())

  id_conv      Int
  conversacion conversaciones @relation(fields: [id_conv], references: [id_conv])

  id_remitente Int
  remitente    usuarios @relation(fields: [id_remitente], references: [id_usu])

  contenido String   @db.Text
  fecha_msj DateTime @default(now())
  leido     Boolean  @default(false)
}
